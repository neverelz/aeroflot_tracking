# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Интервал в часах
CHECK_INTERVAL=3

# Между стартами любых двух проверок всегда не меньше 10 секунд.
# Можно увеличить, но значение меньше 10 будет автоматически поднято до 10.
MIN_CHECK_GAP_SECONDS=10

# Как быстро замечать новые заявки, в секундах
QUEUE_POLL_SECONDS=5

# false для локального запуска с окном браузера, true для Docker/сервера
HEADLESS=false
